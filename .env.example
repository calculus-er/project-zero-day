GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
TAVILY_API_KEY=your_tavily_api_key_here
GITHUB_WEBHOOK_SECRET=your_secret_here
# Optional: comma-separated branch names only (e.g. main). Omit to allow all except remediation/* (PR loop guard).
# GITHUB_WEBHOOK_ONLY_BRANCHES=main
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
# Optional: path to ngrok.exe if not on PATH (default on this machine: C:\ngrok\ngrok.exe)
# NGROK_EXE=C:\ngrok\ngrok.exe
TARGET_URL=http://localhost:5000
# Tier 1: single Flask app in this folder; Docker mounts it at /app
ARENA_SOURCE_DIR=arena/source
# Which ``*.py`` runs in the container: explicit name, or ``auto`` if exactly one non-backup .py exists
ARENA_ENTRY_FILE=app.py
# Easier workflow: put any ``*.py`` in arena/incoming/; sync copies it onto arena/source/app.py (see below).
# ARENA_INCOMING_DIR=arena/incoming
# ARENA_INCOMING_FILE=my_vuln.py
# Docker: copy incoming → app.py on container start (compose passes ARENA_INCOMING_SYNC)
# ARENA_INCOMING_SYNC=false
DEFAULT_VULN_TYPE=sqli
OMIUM_API_KEY=your_omium_api_key_here
# Must match workflow name in Omium dashboard (GET /workflows)
OMIUM_PROJECT=zero-day
OMIUM_API_URL=https://api.omium.ai
# Optional: override auto-detected workflow UUID
# OMIUM_WORKFLOW_ID=your-workflow-uuid-here
# Optional: defaults to {workflow_id}-agent
# OMIUM_AGENT_ID=your-agent-id
# Set to false to stop ALL Omium API usage (emergency kill switch)
OMIUM_TRACING_ENABLED=true
# Faster demos: fewer searches, shorter pauses (breach usually on attempt 2–3)
SCAN_FAST_MODE=false
GROQ_MIN_DELAY_SECONDS=2

# Phase 8E: after Epsilon patches arena/source, Zeta runs `docker compose restart`
# on this service and polls GET {TARGET_URL}/health (default: true).
AUTO_RESTART_TARGET=true
# Optional: override repo root when docker-compose.yml lives elsewhere
# DOCKER_COMPOSE_CWD=
# Optional: Compose service name (default: target)
# DOCKER_COMPOSE_SERVICE=target
# TARGET_HEALTH_MAX_WAIT_SECONDS=90
# TARGET_HEALTH_POLL_INTERVAL=1.5

# Phase 8F: reset script sample (default: arena/samples/app.py)
# ARENA_RESET_SAMPLE=

# --- Phase 9: webhook → clone demo → PR with remediated file (GitHub token with repo scope) ---
# GITHUB_TOKEN=github_pat_...
# On push webhook: shallow-clone GITHUB_DEMO_REPO and copy DEMO_APP_RELATIVE_PATH into arena/source (filename preserved)
# GITHUB_DEMO_SYNC_ON_WEBHOOK=false
# GITHUB_DEMO_REPO=owner/zero-day-demo-target
# GITHUB_DEMO_BRANCH=main
# DEMO_APP_RELATIVE_PATH=app.py
# Remove other ``*.py`` in arena/source before copy (allows ARENA_ENTRY_FILE=auto)
# GITHUB_DEMO_EXCLUSIVE_SYNC=false
# git clone timeout seconds (private repos need GITHUB_TOKEN; avoids hanging on credential prompts)
# GITHUB_DEMO_CLONE_TIMEOUT=120
# After a successful copy: docker compose restart target + poll /health before Red Swarm
# GITHUB_DEMO_RESTART_TARGET=true

# After Blue Swarm (logic pass): open PR from branch remediation/<scan-id>
# GITHUB_PR_ENABLED=false
# Often same as GITHUB_DEMO_REPO
# GITHUB_PR_REPO=owner/zero-day-demo-target
# GITHUB_PR_BASE_BRANCH=main
# Path inside that repo to update (must exist on base branch for update flow)
# GITHUB_PR_FILE_PATH=app.py
# GITHUB_PR_TITLE_PREFIX=Security remediation (Blue Swarm)
